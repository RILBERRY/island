{
  "name": "l15-isdhoo",
  "private": true,
  "version": "0.1.0",
  "description": "L15 — Explore Isdhoo. Meet your friends. A 3D island hangout for L. Isdhoo, Maldives.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,green \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "serve": "npm run build && NODE_ENV=production tsx server/index.ts",
    "stop": "pkill -f 'tsx server/index.ts' || true",
    "world": "python3 -I tools/build-world.py data/laamu-osm.json public/world/isdhoo.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "chess.js": "^1.4.0",
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
